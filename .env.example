# CampusGate Environment Variables Template

# Supabase PostgreSQL & Auth Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Institutional Default Settings
VITE_DEFAULT_ATTENDANCE_THRESHOLD=75.0
VITE_DATA_FRESHNESS_DAYS=30
VITE_ENFORCE_STRICT_VERIFICATION=true

# Mode
VITE_APP_ENV=development
